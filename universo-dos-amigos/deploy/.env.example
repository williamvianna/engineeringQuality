# ═══════════════════════════════════════════════════════════
#   Universo dos Amigos — Variáveis de Ambiente (Hostinger)
# ═══════════════════════════════════════════════════════════
#
# Copie este arquivo como ".env" e preencha os valores abaixo.
# As tabelas do banco são criadas automaticamente no primeiro start.

# ─── Banco de dados MySQL (OBRIGATÓRIO) ───────────────────
# Crie o banco no painel Hostinger → Banco de Dados → MySQL
# Anote: nome do banco, usuário, senha e host
DATABASE_URL=mysql://USUARIO:SENHA@localhost:3306/NOME_DO_BANCO

# ─── Segurança (OBRIGATÓRIO) ──────────────────────────────
# Qualquer texto longo e aleatório (mínimo 32 caracteres)
SESSION_SECRET=mude_para_uma_frase_longa_e_secreta_aqui_2024

# ─── Mercado Pago PIX (OBRIGATÓRIO para confirmar pagamentos) ──
# Painel MP → Seu negócio → Credenciais → Produção → Access Token
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-0000000000000000-000000-00000000000000000000000000000000-000000000

# ─── URL do site (OBRIGATÓRIO para webhook automático do MP) ──
# Exemplo: https://universodosamigos.com.br  (sem barra no final)
APP_URL=https://seudominio.com.br

# ─── Ambiente ─────────────────────────────────────────────
NODE_ENV=production

# ─── Porta (NÃO ALTERAR — Hostinger define automaticamente) ──
# PORT=3000
